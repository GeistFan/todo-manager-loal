<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="todo.htlkaindorf.application.HelloController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Filterleiste -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Filter nach Status:" />
        <ComboBox fx:id="filterComboBox" onAction="#onFilterChanged" promptText="Alle anzeigen" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onSave" text="Speichern" />
        <Button onAction="#onLoad" text="Laden" />
    </HBox>

    <ListView fx:id="listView" prefHeight="398.0" prefWidth="500.0" />

    <!-- Eingabe- und Aktionsbereich -->
    <VBox spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
        <Label style="-fx-font-weight: bold;" text="Aufgabe verwalten:" />
        <TextField fx:id="titleField" promptText="Titel..." />
        <TextArea fx:id="descArea" prefRowCount="2" promptText="Beschreibung..." />

        <HBox spacing="10.0">
            <ComboBox fx:id="prioComboBox" prefHeight="25.0" prefWidth="100.0" promptText="Priorität" />
            <DatePicker fx:id="datePicker" />
        </HBox>

        <HBox spacing="10.0" style="-fx-padding: 5 0 0 0;">
         <ComboBox fx:id="stateComboBox" onAction="#onChangeState" prefHeight="25.0" prefWidth="100.0" promptText="State" />
            <Button fx:id="addButton" onAction="#onAddTodo" text="Erstellen" />
            <Button fx:id="pauseButton" onAction="#onPauseState" text="Pausieren" />
            <Button fx:id="deleteButton" onAction="#onDeleteTodo" text="Löschen" />
        </HBox>
    </VBox>
</VBox>
