<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="todo.htlkaindorf.application.HelloController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Filterleiste -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Filter nach Status:" />
        <ComboBox fx:id="filterComboBox" promptText="Alle anzeigen" onAction="#onFilterChanged" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Speichern" onAction="#onSave" />
        <Button text="Laden" onAction="#onLoad" />
    </HBox>

    <ListView fx:id="listView" prefHeight="200.0" />

    <!-- Eingabe- und Aktionsbereich -->
    <VBox spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
        <Label style="-fx-font-weight: bold;" text="Aufgabe verwalten:" />
        <TextField fx:id="titleField" promptText="Titel..." />
        <TextArea fx:id="descArea" prefRowCount="2" promptText="Beschreibung..." />

        <HBox spacing="10.0">
            <ComboBox fx:id="prioComboBox" promptText="Priorität" />
            <DatePicker fx:id="datePicker" />
        </HBox>

        <HBox spacing="10.0" style="-fx-padding: 5 0 0 0;">
            <Button fx:id="addButton" text="Erstellen" onAction="#onAddTodo" />
            <Button fx:id="nextStateButton" text="Status Weiter" onAction="#onNextState" />
            <Button fx:id="pauseButton" text="Pausieren" onAction="#onPauseState" />
            <Button fx:id="deleteButton" text="Löschen" onAction="#onDeleteTodo" />
        </HBox>
    </VBox>
</VBox>